#!/usr/bin/env python3
"""Manual recording, on top of the replay: record-clip start | stop | toggle.

Global shortcuts: Alt+F9 starts, Alt+F11 stops (setup_shortcut.py). Goes through the command channel of the
replay's gpu-screen-recorder (no second encode); on stop, gpu-screen-recorder writes the file then runs
on_save.py just like for a replay (renaming after the game, tracks, popup, sound).
"""
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from clips_common import (APP_DIR, extra_monitors, extra_socket, gsr_request, layer_shell_available, load_config,  # noqa: E402
                          manual_recording_started, play_sound, set_manual_recording, shortcut_label)


def tell(title, body="", icon="media-record", sound=None, popup=False):
    """Discreet feedback while gaming: sound, then a toast over the game or a notification depending on settings."""
    cfg = load_config()
    if sound and cfg.get("save_sound", True):
        play_sound(sound, cfg.get("sound_volume", 70))
    if popup and cfg.get("save_popup", True) and layer_shell_available():
        subprocess.Popen([sys.executable, os.path.join(APP_DIR, "popup.py"), "--message", title, body],
                         start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    if cfg.get("save_notification", True) or not popup:
        subprocess.run(["notify-send", "-a", "Clips", "-i", icon, "-t", "3000",
                        "-h", "string:desktop-entry:local.clips.Clips", title, body],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def videos(folder):
    try:
        return [e.path for e in os.scandir(folder) if e.is_file() and e.name.lower().endswith((".mp4", ".mkv"))]
    except OSError:
        return []


def start():
    if manual_recording_started() is not None:
        tell("Already recording", f"{shortcut_label('rec_stop')} to stop it", popup=True)
        return 0
    folder = load_config()["clips_dir"]
    before = set(videos(folder))
    ok, data = gsr_request("start-replay-recording")
    if ok:   # other screens (no audio): aligned afterwards thanks to the timestamp of their 1st frame
        for mon in extra_monitors(load_config()):
            gsr_request("start-replay-recording", sock_path=extra_socket(mon))
    if ok is None:
        tell("Clips", "The replay is not running: turn it on in the Clips app to be able to record.",
             icon="dialog-warning")
        return 1
    if not ok:
        tell("Could not start the recording", str(data or ""), icon="dialog-error")
        return 1
    started = time.time()
    set_manual_recording(started)
    tell("Recording started", f"{shortcut_label('rec_stop')} to stop it", sound="highlight", popup=True)
    # The file shows up in the folder right from the start: note it so the library shows it as "Recording"
    # (greyed out, not playable yet) instead of an incomplete clip.
    for _ in range(40):
        new = [p for p in videos(folder) if p not in before and not os.path.basename(p).startswith("Replay_")]
        if new:
            set_manual_recording(started, max(new, key=os.path.getmtime))
            break
        time.sleep(0.1)
    return 0


def stop():
    started = manual_recording_started()
    # Reply sent once the file is written (and on_save.py started): give long videos time.
    # Other screens first: their files are complete when on_save.py (started by the main screen)
    # attaches them.
    for mon in extra_monitors(load_config()):
        gsr_request("stop-replay-recording", timeout=120, sock_path=extra_socket(mon))
    ok, data = gsr_request("stop-replay-recording", timeout=120)
    set_manual_recording(None)
    if ok is None:
        tell("Clips", "The replay is not running.", icon="dialog-warning")
        return 1
    if not ok:
        if started is None:
            tell("No recording in progress", f"{shortcut_label('rec_start')} to start one", popup=True)
        else:
            tell("Failed to stop the recording", str(data or ""), icon="dialog-error")
        return 1
    return 0   # the rest ("Recording saved" popup, sound) is done by on_save.py


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if action == "toggle":
        action = "stop" if manual_recording_started() is not None else "start"
    if action not in ("start", "stop"):
        print(__doc__)
        sys.exit(2)
    sys.exit(start() if action == "start" else stop())
